# 프론트(Vite) 공개값 — 브라우저에 노출되는 값만 넣는다. 비밀키 절대 금지.
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=
# Toss 결제 공개 클라이언트 키(테스트 키 test_ck_ 만 허용 — 운영 키 금지). 비밀키(test_sk_/live_sk_)는 절대 여기 넣지 않는다.
VITE_PUBLIC_TOSS_CLIENT_KEY=
# (2026-09-05 통합) DO IT(A 구조 · 당신이 잠든 사이에)은 같은 앱 안 /doit 에 있다. 별도 주소 변수 불필요.

# 서버 함수(get-step-question · echo-journey · echo-payment · openai-chat) 비밀값 — Supabase 대시보드 > Edge Functions > Secrets 에만 등록한다. 이 파일·소스에 값 저장 금지.
# OPENAI_API_KEY=
# OPENAI_MODEL=        (예: 운영에서 확정한 모델명. 코드에 기본값 없음 — 없으면 AI_NOT_CONFIGURED)
# TOSS_SECRET_KEY=      (echo-payment 전용. test_sk_ 로 시작하는 테스트 비밀키만 허용 — 운영 키는 서버가 거절)
# ALLOWED_ORIGINS=      (openai-chat 전용. 이 앱이 뜨는 주소들, 쉼표 구분. 예: https://*.readdy.co,https://readdy.ai)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 는 Edge Runtime 이 자동 주입한다.

# QA 검사 도구(/qa/doit-understanding) 노출 스위치. 기본은 꺼짐이며 운영 빌드에는 절대 넣지 않는다.
# true 로 빌드한 산출물에만 QA 화면이 들어간다. 보안 경계가 아니라 노출 제어일 뿐이고,
# 실제 경계는 서버(doit-understanding)의 토큰 검증과 RLS 다.
# VITE_QA_HARNESS=

# A 구조 자기이해 서버 저장 스위치. 대표 승인 전까지 켜지 않는다(없으면 false).
# VITE_A_STRUCTURE_SERVER_ENABLED=

# 다음 질문 기능. drafts의 DB 변경과 doit-understanding 서버 배포·검증 후에만 true.
# 화면 빌드만 바꾸어서는 서버 기능이 생기지 않는다. 기본 false.
# VITE_ECHO_FOLLOWUP_ENABLED=

# 사이트 역할(대표 확정 2026-09-21). brand = do-it.company(브랜딩만) / app = app.do-it.company(제품 전부) / 비우면 통합 빌드.
# VITE_SITE_ROLE=brand
# 브랜드 사이트가 제품으로 보낼 주소(기본 https://app.do-it.company). 검사용 주소로 바꿀 수 있다.
# VITE_APP_ORIGIN=https://app.do-it.company
