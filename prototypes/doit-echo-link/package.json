{
  "name": "doit-echo-link",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DOIT COMPANY 홈페이지(Clarix) → ECHO 모바일(Flora) 연결 시안. 운영 배포·결제·DB와 무관한 독립 시안.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hash": "tsc -b && VITE_ROUTER=hash vite build --base ./ --outDir dist-hash",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/my-soul": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "@fontsource/sarabun": "5.3.0",
    "@react-spring/web": "10.1.2",
    "lenis": "1.3.23",
    "lenis-flora": "npm:lenis@1.3.26",
    "pretendard": "1.3.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4",
    "resize-observer-polyfill": "1.5.1",
    "spring-text-engine": "0.1.5",
    "three": "0.184.0",
    "three-flora": "npm:three@0.186.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.184.1",
    "@types/three-flora": "npm:@types/three@0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
