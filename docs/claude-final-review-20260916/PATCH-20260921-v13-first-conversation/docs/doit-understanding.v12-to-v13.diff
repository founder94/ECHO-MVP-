+const BLOCKED_PATTERNS: readonly { reason: BlockedReason; pattern: RegExp }[] = [
+  { reason: "phone", pattern: /(?:\+?82[-\s.]?)?0?1[016789][-\s.]?\d{3,4}[-\s.]?\d{4}/ },
